RPC_URL=http://127.0.0.1:8899
PROGRAM_ID=<your_program_id>

# ── Keypair du launch wallet (choisir l'une des deux options) ──
# Option A — Local uniquement (développement)
EXECUTOR_KEYPAIR_PATH=/path/to/launch-wallet.json
# Option B — Production / VPS (base64 du contenu du fichier JSON)
# Générer avec : scripts/encode-keypair.sh /path/to/launch-wallet.json
EXECUTOR_KEYPAIR_BASE64=

ADMIN_KEYPAIR_PATH=/path/to/admin-wallet.json
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_ANON_KEY=<your_anon_key>
SUPABASE_SERVICE_ROLE_KEY=<your_service_role_key>
PLATFORM_FEE_WALLET=<your_platform_fee_wallet_pubkey>
# pump.fun — mettre à true et fournir un RPC mainnet/devnet pour activer
PUMP_FUN_ENABLED=false
PUMP_FUN_RPC_URL=
